generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection (runtime)
  directUrl = env("DIRECT_URL")   // Neon direct connection (Prisma Migrate)
}

enum UserRole {
  INVESTOR
  ADMIN
}

enum LeadStatus {
  NEW
  RESEARCHING
  CONTACTING
  FOLLOW_UP
  INTERESTED
  NOT_INTERESTED
  CLOSED_DEAL
}

enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SignalSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum IngestionStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum MunicipalJurisdiction {
  INSIDE_OMAHA
  OUTSIDE_OMAHA
  CROSSES_BOUNDARY
  UNRESOLVED
}

enum TaxLienObservationState {
  PRESENT_IN_CURRENT_SNAPSHOT
  ABSENT_FROM_LATEST_SNAPSHOT
  OFFICIALLY_CONFIRMED_RELEASED_OR_REDEEMED
}

enum TaxLienMatchState {
  MATCHED_TO_CANONICAL_PROPERTY
  UNMATCHED_COUNTY_PIN
  QUARANTINED_MALFORMED
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String?
  role            UserRole        @default(INVESTOR)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  savedProperties SavedProperty[]
  notes           PropertyNote[]

  @@map("users")
}

model Property {
  id                  String          @id @default(cuid())
  parcelId            String          @unique // Douglas County PIN format (e.g. "0421000000")
  address             String          // e.g. "2418 N 24th St"
  city                String          @default("Omaha")
  state               String          @default("NE")
  zip                 String          // e.g. "68110"
  neighborhood        String?         // Benson, Dundee, North Omaha, South Omaha, Millard, Florence
  propertyType        String          // SINGLE_FAMILY, MULTI_FAMILY, COMMERCIAL, VACANT_LOT
  yearBuilt           Int?
  bedrooms            Int?
  bathrooms           Float?
  squareFeet          Int?
  lotSizeSqFt         BigInt?
  assessedValue       Float?
  estimatedValue      Float?
  estimatedEquityPct  Float?          // e.g. 0.85 = 85% equity
  
  // Computed Opportunity & Confidence Scores
  opportunityScore    Int             @default(0) // 0 - 100
  dataConfidence      ConfidenceLevel @default(MEDIUM)
  scoreBreakdownJson  Json?           // Structured array of contributing factors
  lastScoredAt        DateTime?
  
  // County GIS & Assessment extensions (Additive)
  countyClass         String?         // Raw Douglas County CLASS ('R', 'C', 'M', 'I', etc.)
  dcaAccountType      String?         // Douglas County Assessor Account Type (DCAACCTYPE)
  condition           String?         // Assessor condition code
  quality             String?         // Assessor quality rating
  legalDescription    String?         // Consolidated ADDITION_N, BLOCK, LOT, LEGAL1
  assessorUrl         String?         // Direct portal link to County Assessor
  treasurerUrl        String?         // Direct portal link to County Treasurer
  latitude            Float?          // WGS84 Centroid Latitude
  longitude           Float?          // WGS84 Centroid Longitude
  geometryGeoJson     Json?           // WGS84 Boundary Polygon coordinates
  hasAuthoritativeAddress Boolean     @default(true) // false when source parcel situs address was missing or unassigned
  municipalJurisdiction   MunicipalJurisdiction @default(UNRESOLVED) // Fails closed to UNRESOLVED, never auto-eligible
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relational Connections
  ownershipRecords    OwnershipRecord[]
  taxRecords          TaxRecord[]
  codeViolations      CodeViolation[]
  signals             Signal[]
  events              PropertyEvent[]
  sourceRecords       SourceRecord[]
  savedProperties     SavedProperty[]
  notes               PropertyNote[]
  scoreHistory        ScoreHistory[]
  hotlineReports      HotlineReport[]
  taxLienRecords      TaxLienRecord[]

  @@index([opportunityScore])
  @@index([neighborhood])
  @@index([zip])
  @@index([latitude, longitude])
  @@index([municipalJurisdiction])
  @@map("properties")
}

model OwnershipRecord {
  id              String    @id @default(cuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownerName       String    // Synthetic demo name (e.g. "Demo Asset Holdings LLC")
  mailingAddress  String
  mailingCity     String
  mailingState    String
  mailingZip      String
  isAbsentee      Boolean   @default(false)
  isOutOfState    Boolean   @default(false)
  isCorporate     Boolean   @default(false)
  
  // Conservative Ownership Evaluation Status (Additive)
  absenteeStatus   String?   // "ABSENTEE" | "OWNER_OCCUPIED" | "UNKNOWN"
  outOfStateStatus String?   // "OUT_OF_STATE" | "IN_STATE" | "UNKNOWN"
  corporateStatus  String?   // "CONFIRMED_CORPORATE" | "INDIVIDUAL" | "UNKNOWN"

  purchaseDate    DateTime?
  purchasePrice   Float?
  deedType        String?   // Warranty Deed, Quitclaim, Sheriff's Deed
  ownershipYears  Float?
  isCurrent       Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([propertyId])
  @@map("ownership_records")
}

model TaxRecord {
  id               String    @id @default(cuid())
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  taxYear          Int
  totalAssessed    Float
  annualTaxDue     Float
  amountDelinquent Float     @default(0)
  isDelinquent     Boolean   @default(false)
  delinquentYears  Int       @default(0)
  taxSaleStatus    String?   // None, Tax Lien Issued, Sold at Tax Sale
  createdAt        DateTime  @default(now())

  @@index([propertyId])
  @@index([isDelinquent])
  @@map("tax_records")
}

model CodeViolation {
  id                         String         @id @default(cuid())
  sourceName                 String         @default("OMAHA_ACCELA_CODE_ENFORCEMENT")
  sourceObjectId             Int?           // ESRI objectid
  sourceGlobalId             String?        // ESRI globalid
  caseNumber                 String         @unique // permitnum e.g. "CASE-15-00154" or "CIT-23-00007"
  sourcePin                  String         @default("") // 10-digit PIN from Accela (e.g. "2438320000")
  
  // Property Association (Nullable for strict exact match & unmatched quarantine)
  propertyId                 String?
  property                   Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  matchStatus                String         @default("UNMATCHED") // "MATCHED_EXACT_PIN" | "UNMATCHED_COUNTY_PIN"
  
  // Case Classification
  caseType                   String         @default("Housing Inspection Case") // "Housing Inspection Case" | "Citation Record"
  caseRecordClassMapped      String?        // "Code Case" | "Citation Record"
  
  // Verbatim Upstream Statuses & Categorized Stage
  statusCurrent              String         @default("Unknown") // "In Violation", "Closed", "Inspection Scheduled", etc.
  statusCurrentMapped        String         @default("Unknown") // "Active Violation", "Closed", "Citation Issued", etc.
  enforcementStage           String         @default("UNKNOWN_STAGE") // "ACTIVE_CONFIRMED_VIOLATION" | "ACTIVE_LEGAL_CITATION" | "INSPECTION_PENDING" | "CLOSED_COMPLIED" | "CLOSED_UNFOUNDED" | "CLOSED_HISTORICAL"
  
  // Backward compatibility fields for legacy synthetic DTO consumers
  violationType              String         @default("HOUSING_CODE_INSPECTION")
  severity                   SignalSeverity @default(MEDIUM)
  status                     String         @default("OPEN")
  description                String         @default("")
  inspectorNotes             String?
  violationDate              DateTime?      // effective opened or initial inspection date
  
  // Critical Investor Distress Flags
  isVacant                   Boolean        @default(false) // vacant === 'Yes'
  vacateReason               String?        // e.g. "Non-Compliance"
  hasDemoOrder               Boolean        @default(false) // demo_order === 'Yes'
  demoIssuedDate             DateTime?
  
  // Key Inspection & Compliance Timestamps
  openedDate                 DateTime?      // first_process_date or initial_inspection
  initialInspectionDate      DateTime?      // initial_inspection
  lastReInspectionDate       DateTime?      // last_re_inspection
  complianceDeadline         DateTime?      // first_compliance_deadline or extended_compliance_deadline
  complianceDate             DateTime?      // compliance_date
  lastUpdatedSource          DateTime?      // lastupdated (epoch ms from ESRI)
  
  // Situs Address Recorded at Inspection
  originalAddress            String?
  originalCity               String?
  originalState              String?
  originalZip                String?
  
  // Source Provenance & Official Portal Link
  accelaUrl                  String?        // direct link to Omaha Permits Citizen Access portal
  latestSourceRecordId       String?
  latestSourceRecord         SourceRecord?  @relation(fields: [latestSourceRecordId], references: [id], onDelete: SetNull)
  
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([propertyId])
  @@index([sourcePin])
  @@index([statusCurrentMapped])
  @@index([enforcementStage])
  @@index([matchStatus])
  @@index([isVacant])
  @@index([hasDemoOrder])
  @@map("code_violations")
}

model Signal {
  id                String         @id @default(cuid())
  propertyId        String
  property          Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  signalType        String         // TAX_DELINQUENT, CODE_VIOLATION, REPEAT_VIOLATOR, ABSENTEE_OWNER, LONG_TENURE, VACANCY_INDICATOR
  category          String         // FINANCIAL_DISTRESS, PROPERTY_DISTRESS, OWNERSHIP_SIGNAL, RECENCY_SIGNAL
  scoreContribution Int            // Points added to score
  severity          SignalSeverity @default(MEDIUM)
  eventDate         DateTime
  discoveredAt      DateTime       @default(now())
  status            String         @default("ACTIVE") // ACTIVE, RESOLVED, HISTORICAL
  sourceType        String         // DOUGLAS_COUNTY_TREASURER, CITY_OMAHA_CODE_ENFORCEMENT, REGISTER_OF_DEEDS
  sourceRecordId    String?
  sourceRecord      SourceRecord?  @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  metadataJson      Json?          // Contextual payload

  @@index([propertyId])
  @@index([signalType])
  @@map("signals")
}

model PropertyEvent {
  id              String        @id @default(cuid())
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  eventDate       DateTime
  eventType       String        // PURCHASE, MAILING_CHANGE, CODE_VIOLATION, TAX_DELINQUENCY, STATUS_CHANGE
  title           String
  description     String
  severity        String?       // INFO, WARNING, DANGER, SUCCESS
  sourceRecordId  String?
  sourceRecord    SourceRecord? @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@index([propertyId])
  @@index([eventDate])
  @@map("property_events")
}

model SourceRecord {
  id              String          @id @default(cuid())
  propertyId      String?
  property        Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  sourceName      String          // e.g. "DOUGLAS_COUNTY_ASSESSOR", "OMAHA_CODE_ENFORCEMENT"
  sourceRecordId  String          // External synthetic identifier
  rawPayloadJson  Json            // Complete unaltered immutable raw source payload
  ingestionRunId  String?
  ingestionRun    IngestionRun?   @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)
  matchedStatus   String          @default("MATCHED") // MATCHED, UNMATCHED, DUPLICATE_CANDIDATE
  ingestedAt      DateTime        @default(now())
  signals         Signal[]
  events          PropertyEvent[]
  hotlineReports  HotlineReport[]
  taxLienRecords  TaxLienRecord[]
  codeViolations  CodeViolation[]

  @@unique([sourceName, sourceRecordId])
  @@index([propertyId])
  @@map("source_records")
}

model IngestionRun {
  id              String          @id @default(cuid())
  sourceName      String
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  status          IngestionStatus @default(RUNNING)
  recordsIngested Int             @default(0)
  signalsCreated  Int             @default(0)
  statsJson       Json?
  errorsJson      Json?
  sourceRecords   SourceRecord[]

  @@map("ingestion_runs")
}

model ScoreHistory {
  id              String    @id @default(cuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  score           Int
  scoreBreakdown  Json      // JSON snapshot of contributing factors at time of calculation
  calculatedAt    DateTime  @default(now())

  @@index([propertyId])
  @@map("score_history")
}

model SavedProperty {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status          LeadStatus    @default(NEW)
  priority        PriorityLevel @default(NORMAL)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, propertyId])
  @@map("saved_properties")
}

model PropertyNote {
  id              String    @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  content         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([propertyId])
  @@map("property_notes")
}

model HotlineReport {
  id                   String        @id @default(cuid())
  sourceName           String        @default("OMAHA_HOTLINE")
  sourceGlobalId       String        @unique // ArcGIS globalid (stable UUID)
  sourceObjectId       Int           // ArcGIS objectid (for direct upstream reference)
  requestId            String?       // City of Omaha public request identifier (e.g. "629894")
  reportCategory       String?       // Broad category e.g. "Code/Housing Violati", "Pothole", "Parks_Trees_Weeds"
  problemType          String?       // Detailed problem type (PROBTYPE)
  locationText         String?       // LOCDESC e.g. "1701 Farnam St, Omaha, NE, 68102"
  status               String?       // Raw City status code e.g. "CLOSED", "IP", "Submitted"
  recordKind           String        @default("UNVERIFIED_COMPLAINT") // Distinguished from confirmed code violations
  reportedAt           DateTime?     // Effective report date (SUBMITDT fallback to CreationDate)
  reportedAtSource     String?       // "SUBMITDT" | "CreationDate"
  completedAt          DateTime?     // Actual completion date (ACTDATE)
  sourceCreatedAt      DateTime?     // CreationDate in ArcGIS
  sourceEditedAt       DateTime?     // EditDate in ArcGIS (used for change detection)
  latitude             Float?        // WGS84 point latitude (from ESRI point geometry)
  longitude            Float?        // WGS84 point longitude (from ESRI point geometry)
  publicView           String        // Explicitly "Yes"
  sourceUrl            String        // Direct REST query URL for the exact record
  propertyId           String?       // Future linkage for parcel match
  property             Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  matchStatus          String        @default("UNMATCHED") // UNMATCHED, CONFIRMED, PROBABLE_UNRESOLVED, AMBIGUOUS_MULTI_PARCEL, AMBIGUOUS_CONFLICT, EXCLUDED_INFRASTRUCTURE
  
  // Conservative Match Audit (Additive)
  matchMethod          String?       // "EXACT_ADDR_AND_POLYGON" | "UNRESOLVED"
  matchConfidence      String?       // "CONFIRMED" | "UNRESOLVED" | "EXCLUDED_INFRASTRUCTURE"
  matchAuditJson       Json?         // Structured audit payload explaining decision
  matchedAt            DateTime?

  latestSourceRecordId String?
  latestSourceRecord   SourceRecord? @relation(fields: [latestSourceRecordId], references: [id], onDelete: SetNull)
  firstSeenAt          DateTime      @default(now())
  lastSeenAt           DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([requestId])
  @@index([reportCategory])
  @@index([status])
  @@index([reportedAt])
  @@index([propertyId])
  @@index([latitude, longitude])
  @@index([matchStatus])
  @@map("hotline_reports")
}

model TaxLienRecord {
  id                   String                  @id @default(cuid())
  sourceName           String                  @default("DOUGLAS_COUNTY_TAX_LIEN")
  sourceObjectId       Int
  sourcePin            String
  taxYear              String?
  amountCents          Int
  amountFormatted      String
  situsAddress         String?
  countyClass          String?
  addition             String?
  propertyId           String?
  property             Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  matchStatus          TaxLienMatchState       @default(UNMATCHED_COUNTY_PIN)
  observationStatus    TaxLienObservationState @default(PRESENT_IN_CURRENT_SNAPSHOT)
  firstObservedAt      DateTime                @default(now())
  lastObservedAt       DateTime                @default(now())
  latestSourceRecordId String?
  latestSourceRecord   SourceRecord?           @relation(fields: [latestSourceRecordId], references: [id], onDelete: SetNull)
  contentSha256        String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([sourceName, sourceObjectId])
  @@index([sourcePin])
  @@index([propertyId])
  @@index([matchStatus])
  @@index([observationStatus])
  @@map("tax_lien_records")
}

