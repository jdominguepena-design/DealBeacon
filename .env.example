# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Never paste these values into chat, issues, or commits.

# Neon POOLED connection (host contains "-pooler"). Used by the app and importer at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.REGION.aws.neon.tech/dealbeacon?sslmode=require"

# Neon DIRECT connection (same host WITHOUT "-pooler"). Used by Prisma Migrate only.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/dealbeacon?sslmode=require"

NODE_ENV="development"
